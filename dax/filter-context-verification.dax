DEFINE
 VAR Checks = UNION(
ROW("Test", "All reports", "Expected", 30000, "Actual", [Incoming Reports]),
ROW("Test", "Resolved", "Expected", 29733, "Actual", [Resolved Reports]),
ROW("Test", "Strict Open", "Expected", 2, "Actual", [Open Reports]),
ROW("Test", "In Progress", "Expected", 265, "Actual", [In Progress Reports]),
ROW("Test", "Active", "Expected", 267, "Actual", [Active Reports]),
ROW("Test", "High risk", "Expected", 3371, "Actual", [High Risk Reports]),
ROW("Test", "Open high risk", "Expected", 0, "Actual", [Open High Risk Reports]),
ROW("Test", "Active high risk", "Expected", 39, "Actual", [Active High Risk Reports]),
ROW("Test", "Nominal capacity", "Expected", 356984, "Actual", [Nominal Incident Capacity]),
ROW("Test", "Recall", "Expected", 0.8528546203649205, "Actual", [Model Recall]),
ROW("Test", "Precision", "Expected", 0.33619489559164734, "Actual", [Model Precision]),
ROW("Test", "ROC AUC", "Expected", 0.6870204944679009, "Actual", [Model ROC AUC]),
ROW("Test", "Review threshold", "Expected", 0.24, "Actual", [Model Decision Threshold]),
ROW("Test", "SLA resolved denominator", "Expected", 0.7351091379948206, "Actual", [SLA Compliance]),
ROW("Test", "Mean model score", "Expected", 0.2879907483150329, "Actual", [Average Predicted Risk]),
ROW("Test", "Unvalidated scenario is blank", "Expected", BLANK(), "Actual", [Effective Incident Capacity]),
ROW("Test", "DimShift Morning reports", "Expected", 10190, "Actual", CALCULATE([Incoming Reports], DimShift[Shift] = "Morning")),
ROW("Test", "DimShift Morning capacity", "Expected", 125240, "Actual", CALCULATE([Nominal Incident Capacity], DimShift[Shift] = "Morning")),
ROW("Test", "DimTime Morning reports", "Expected", 10190, "Actual", CALCULATE([Incoming Reports], DimTime[Shift] = "Morning")),
ROW("Test", "DimTime Morning capacity", "Expected", 125240, "Actual", CALCULATE([Nominal Incident Capacity], DimTime[Shift] = "Morning")),
ROW("Test", "Morning active high risk", "Expected", 3, "Actual", CALCULATE([Active High Risk Reports], DimShift[Shift] = "Morning")),
ROW("Test", "DimShift Evening reports", "Expected", 13937, "Actual", CALCULATE([Incoming Reports], DimShift[Shift] = "Evening")),
ROW("Test", "DimShift Evening capacity", "Expected", 159784, "Actual", CALCULATE([Nominal Incident Capacity], DimShift[Shift] = "Evening")),
ROW("Test", "DimTime Evening reports", "Expected", 13937, "Actual", CALCULATE([Incoming Reports], DimTime[Shift] = "Evening")),
ROW("Test", "DimTime Evening capacity", "Expected", 159784, "Actual", CALCULATE([Nominal Incident Capacity], DimTime[Shift] = "Evening")),
ROW("Test", "Evening active high risk", "Expected", 32, "Actual", CALCULATE([Active High Risk Reports], DimShift[Shift] = "Evening")),
ROW("Test", "DimShift Night reports", "Expected", 5873, "Actual", CALCULATE([Incoming Reports], DimShift[Shift] = "Night")),
ROW("Test", "DimShift Night capacity", "Expected", 71960, "Actual", CALCULATE([Nominal Incident Capacity], DimShift[Shift] = "Night")),
ROW("Test", "DimTime Night reports", "Expected", 5873, "Actual", CALCULATE([Incoming Reports], DimTime[Shift] = "Night")),
ROW("Test", "DimTime Night capacity", "Expected", 71960, "Actual", CALCULATE([Nominal Incident Capacity], DimTime[Shift] = "Night")),
ROW("Test", "Night active high risk", "Expected", 4, "Actual", CALCULATE([Active High Risk Reports], DimShift[Shift] = "Night")),
ROW("Test", "Central reports", "Expected", 6687, "Actual", CALCULATE([Incoming Reports], DimDistrict[DistrictKey] = 1)),
ROW("Test", "Central capacity", "Expected", 43912, "Actual", CALCULATE([Nominal Incident Capacity], DimDistrict[DistrictKey] = 1)),
ROW("Test", "Central Night capacity", "Expected", 10748, "Actual", CALCULATE([Nominal Incident Capacity], DimDistrict[DistrictKey] = 1, DimShift[Shift] = "Night")),
ROW("Test", "April partial capacity", "Expected", 9820, "Actual", CALCULATE([Nominal Incident Capacity], DimDate[DateKey] >= 20260401, DimDate[DateKey] <= 20260405)),
ROW("Test", "April partial reports", "Expected", 793, "Actual", CALCULATE([Incoming Reports], DimDate[DateKey] >= 20260401, DimDate[DateKey] <= 20260405)),
ROW("Test", "Hour 6 reports", "Expected", 811, "Actual", CALCULATE([Incoming Reports], DimTime[Hour] = 6)),
ROW("Test", "Hour unsupported", "Expected", BLANK(), "Actual", CALCULATE([Nominal Incident Capacity], DimTime[Hour] = 6)),
ROW("Test", "TimeBand unsupported", "Expected", BLANK(), "Actual", CALCULATE([Nominal Incident Capacity], DimTime[TimeBand] = "Evening")),
ROW("Test", "Category unsupported", "Expected", BLANK(), "Actual", CALCULATE([Nominal Incident Capacity], DimCategory[CategoryKey] = 1)),
ROW("Test", "Status unsupported", "Expected", BLANK(), "Actual", CALCULATE([Nominal Incident Capacity], FactIncidents[Status] = "Open")),
ROW("Test", "RiskBand unsupported", "Expected", BLANK(), "Actual", CALCULATE([Nominal Incident Capacity], incident_ai_predictions[RiskBand] = "High")),
ROW("Test", "RiskBand does not backfilter incidents", "Expected", 30000, "Actual", CALCULATE([Incoming Reports], incident_ai_predictions[RiskBand] = "High")),
ROW("Test", "Resolved excludes Open high risk", "Expected", 0, "Actual", CALCULATE([Open High Risk Reports], FactIncidents[Status] = "Resolved")),
ROW("Test", "SLA false filter respected", "Expected", 0, "Actual", CALCULATE([SLA Compliance], FactIncidents[SLAMet] = FALSE())),
ROW("Test", "Repeat false filter respected", "Expected", 0, "Actual", CALCULATE([Repeat Reports], FactIncidents[IsRepeat] = FALSE())),
ROW("Test", "Heldout recall not district-specific", "Expected", 0.8528546203649205, "Actual", CALCULATE([Model Recall], DimDistrict[DistrictKey] = 1))
)
 VAR Results = ADDCOLUMNS(Checks, "Pass", IF(ISBLANK([Expected]), ISBLANK([Actual]), NOT ISBLANK([Actual]) && ABS([Actual]-[Expected]) < 0.000000001))
EVALUATE
 ROW("Tests", COUNTROWS(Results), "Passed", COUNTROWS(FILTER(Results,[Pass])), "Failed", COUNTROWS(FILTER(Results,NOT [Pass])))
EVALUATE
 FILTER(Results, NOT [Pass])